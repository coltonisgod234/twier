from flask import render_template, session, request
from copy import deepcopy

DEFAULT_QUERY = {
    "type": "(uninitialized query)",
    "value": {
        "field": None,
        "type": "any",
        "params": []
    }
}

DEFAULT_CLAUSE = {
    "field": None,
    "type": "(unset)",
    "params": []
}

def get_query_data():
    query = session.get("query_base")
    if query == None:
        session["query_base"] = deepcopy(DEFAULT_QUERY)
        return session.get("query_base")  # probably can't fail!
    
    return query

def __search_endpoint():
    query = get_query_data()
    
    return render_template(
        "search/search.html",
        query = query
    )
    
