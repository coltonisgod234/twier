<script>
async function signUp(username, password) {
    const response = await fetch("/api/v1/user/add", {
        method: "POST",
        body: JSON.stringify({
            username: username,
            passwd: password
        }),
        headers: {
            "Content-Type": "application/json"
        }
    })

    return response
}

async function do_signup() {
    let r = await signUp(
        document.getElementById('username').value,
        document.getElementById('password').value
    );

    let status = await r.status;
    let jso = await r.json();
    let err = jso.error
    if (status != 200) {
        document.write(`error during signup, ${status}, ${err}`)
    } else {
        await do_website_login(
            document.getElementById('username').value,
            document.getElementById('password').value
        )
        window.location = "/"
    }
}
</script>